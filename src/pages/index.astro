---
	import Base from "../layouts/Base.astro";
	import { getCollection } from "astro:content";

	const posts = (await getCollection("blog")).sort(
		(a, b) => b.data.updateDate.valueOf() - a.data.updateDate.valueOf()
	);

	const menuDisplay = [
		{name: "About", link: "/about", tag: "Hi!", text: "My name is Alex"},
		{name: "Blog", link: "/blog", tag: "My latest blog", text: posts[0]?.data.title ?? "No blogs yet..."},
		{name: "Dashboard", link: "/dashboard", tag: "What I need every morning", text: "Daily Dashboard"},
		{name: "Projects", link: "/projects", tag: "Featured", text: "BossPlugin"},
		{name: "Reviews", link: "/reviews", tag: "Latest review", text: "No review available"},
	];
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<script src="../scripts/index"/>
		<style>
			body {
				margin:0;
			}

			.mainListItem {
				text-underline-offset: 3px;
				transition: all 0.4s cubic-bezier(.38,-0.25,1,.74);
				display:block;
				z-index:10;
				position:relative;

			}

			.mainListLink {
				font-family: var("--font-Fraunces");
				font-variant: small-caps;
				z-index: 10;
				margin: 0;
			}

			.menuPreview {
				position:absolute;
				top: 20%;
				width: min(14rem, 30vw);
				z-index:1;
				transition: all 0.5s cubic-bezier(0.42, 0, 0.45, 1.04);
				text-align: center;
				pointer-events: none;
				left: -80%;
			}

			.menuPreview.revealed {
				left: 0%;
			}
		</style>
	</head>
	<Base>
		<div id="mainMenu" class="h-dvh relative overflow-hidden p-10 flex justify-between mb-15">
			<ul id="mainList" class="flex-1 mt-12">
				<!-- TODO: Improve mobile experience -->
				{menuDisplay.map((item) => (
					<li class="relative h-[13vh] w-[50vw] items-center">
						<div class="menuPreview" aria-hidden="true">
							<p class="text-mist-700 text-[clamp(0.7rem,1.2vw,0.9rem)]">{item.tag}</p>
							<h4 class="text-[clamp(0.9rem,1.8vw,1.4rem)] font-bold line-clamp-2">{item.text}</h4>
						</div>
						<a href={item.link} class="mainListItem" aria-label={item.name}>
							<span class="mainListLink text-[8vw] sm:text-[6vw] md:text-[4vw]">{item.name}</span>
						</a>
					</li>
				))}
			</ul>
			<div class="self-start w-[40vw] float-right sm:w-[30vw] md:mr-10 lg:mr-30">

				<h1 class="headerFont w-33 mb-2 text-3xl float-right sm:text-6xl sm:w-62 inline">Alex Daly</h1>
				<p class="w-33 max-w-prose text-sm block clear-both float-right sm:w-62">Developer, Student, Reader</p>
				<img src="/assets/index/underConstruction.gif" id="constructionGif" class="absolute bottom-6 right-4 mr-5 mt-5 w-30 h-auto sm:ml-2 sm:w-25 md:ml-5 lg:w-35">
			</div>
		</div>
	</Base>
</html>
