---
	import Base from "../layouts/Base.astro";
	import { getCollection } from "astro:content";

	const posts = (await getCollection("blog")).sort(
		(a, b) => b.data.updateDate.valueOf() - a.data.updateDate.valueOf()
	);

	const menuDisplay = [
		{name: "About", link: "/about", tag: "Hi!", text: "My name is Alex"},
		{name: "Blog", link: "/blog", tag: "My latest blog", text: posts[0]?.data.title ?? "No blogs yet..."},
		{name: "Dashboard", link: "/dashboard", tag: "What I need every morning", text: "Daily Dashboard"},
		{name: "Projects", link: "/projects", tag: "Featured", text: "BossPlugin"},
		{name: "Reviews", link: "/reviews", tag: "Latest review", text: "No review available"},
	];
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<script>
			import type { mainMenuItem } from '../types';
			
			

			const menuItems: mainMenuItem[] = new Array();

			const mainListItems = document.getElementsByClassName("mainListItem") as HTMLCollectionOf<HTMLElement>;
			const mainListLink = document.getElementsByClassName("mainListLink") as HTMLCollectionOf<HTMLElement>;
			const previews = document.getElementsByClassName("menuPreview") as HTMLCollectionOf<HTMLElement>;
			// ["Sans", "Algerian", "Garamond", "Papyrus"]
			const fonts = ["var(--font-Fraunces)", "var(--font-OpenSans)", "var(--font-Recursive)", "var(--font-Roboto)"]

			// Read each letter from the menu items and add it back to the list item as its own element, allowing them to be moved.
			for(var i=0;i<mainListLink.length;i++) {
				let item: mainMenuItem = {
					id: i,
					element: mainListItems[i],
					fontArr: new Array(),
					characters: new Array(),
					timeoutEnter: new Array(),
					timeoutLeave: new Array(),
					slug: mainListItems[i].getAttribute("href")?.toString(),
					preview: previews[i],
				}

				var characters = mainListLink[i].textContent.split("");
				mainListLink[i].textContent = "";
				for(var j=0;j<characters.length;j++) {
					const content = document.createTextNode(characters[j]);
					const element = document.createElement("span");
					element.classList.add("mainListChar");
					element.appendChild(content);
					element.style.transition="0.2s all";
					element.style.display="inline-block";
					element.ariaHidden = "true";
					item.fontArr[j] = j;

					item.characters.push(element);
					mainListLink[i].append(element);
				}
				menuItems.push(item);
			}

			for(let i=0;i<menuItems.length;i++) {
				let item = menuItems[i];
				item.element.addEventListener("mouseenter", () => {
					clearTimeouts(item);

					item.fontInterval = setInterval(() => {
						changeFont(item);
					}, 200);
					
					for(let j=0;j<item.characters.length;j++) {
						if(item.timeoutEnter==undefined) return;

						item.timeoutEnter[j] = setTimeout(() => {
							activateChar(item.characters[j]);
							if(j==item.characters.length-1) {
								item.preview.classList.add("revealed");
							}
						}, j*70);
					}
				});
				item.element.addEventListener("mouseleave", () => {
					clearTimeouts(item);

					for(let j=item.characters.length-1;j>=0;j--) {
						if(item.timeoutLeave==undefined) return;

						item.timeoutLeave[j] = setTimeout(() => {
							resetChar(item.characters[j]);
							if(j==item.characters.length-1) {
								item.preview.classList.remove("revealed");
							}
						}, (item.characters.length-j)*105);
					}
				});
			}
			
			function changeFont(item: mainMenuItem) {
				for(let i=0;i<item.characters.length;i++) {
					// Generate a random number with 1.7x the range of the fonts array. If it is over return the function
					// This gives the font a chance not to change every tick of this function.
					let random = Math.floor(Math.random()*(fonts.length*1.7));
					if(random>=fonts.length) {
						
					}

					item.characters[i].style.fontFamily=fonts[random].toString();
				}
			}

			function activateChar(char: HTMLElement) {
				char.style.translate="28vw";
				char.style.opacity="75%";
			}

			function resetChar(char: HTMLElement) {
				char.style.fontFamily = "Times New Roman";
				char.style.translate="0";
				char.style.opacity="100%";
			}

			function clearTimeouts(item: mainMenuItem) {
				item.timeoutEnter?.forEach(id => clearTimeout(id));
				item.timeoutEnter = new Array();

				item.timeoutLeave?.forEach(id => clearTimeout(id));
				item.timeoutLeave = new Array();

				clearTimeout(item.timeoutVisible);
				
				clearInterval(item.fontInterval);
			}
		
		</script>
		<style>
			body {
				margin:0;
			}

			.mainListItem {
				text-underline-offset: 3px;
				transition: all 0.4s cubic-bezier(.38,-0.25,1,.74);
				display:block;
				z-index:10;
				position:relative;
			}

			.mainListLink {
				font-family:"--font-Fraunces";
				font-variant: small-caps;
				z-index:10;
				margin:0;
				text-shadow: #d2b5ff 3px 3px 5px;
			}

			.menuPreview {
				position:absolute;
				top:20%;
				width: min(14rem, 30vw);
				z-index:1;
				transition: all 0.5s;
				text-align: center;
				pointer-events: none;
				left:-80%;
			}

			.menuPreview.revealed {
				left: -5%;
			}

			body {
				background: #2e80f2;
				background: linear-gradient(135deg, #c9f5e4 0%, #b8d4ff 50%, #d9c2ff 100%);	
			}
		</style>
	</head>
	<Base>
		<div id="mainMenu" class="h-dvh overflow-hidden p-10 flex justify-between mb-15">
			<ul id="mainList" class="flex-1">
				<!-- TODO: Improve mobile experience -->
				{menuDisplay.map((item) => (
					<li class="relative h-[13vh] items-center">
						<div class="menuPreview" aria-hidden="true">
							<p class="text-mist-700 text-[clamp(0.7rem,1.2vw,0.9rem)]">{item.tag}</p>
							<h4 class="text-[clamp(0.9rem,1.8vw,1.4rem)] font-bold line-clamp-2">{item.text}</h4>
						</div>
						<a href={item.link} class="mainListItem" aria-label={item.name}>
							<span class="mainListLink text-[8vw] sm:text-[6vw] md:text-[4vw]">{item.name}</span>
						</a>
					</li>
				))}
			</ul>
			<div id="mainFiller" class="self-start w-[30vw] float-right sm:w-[20vw]">
				<h1 class="text-3xl">Alex Daly</h1>
				<p class="mt-2 max-w-prose max-sm:hidden">Computing student @ NCI, building useful web apps and Minecraft tools, seeking a 6 month placement in Dublin starting Jan 2027</p>
				<p class="mt-2 sm:hidden">Computing student at NCI</p>
				<img src="/assets/index/underConstruction.gif" class="ml-12 mt-5 w-15 h-auto sm:ml-2 sm:w-25 md:ml-5 lg:w-35">
			</div>
		</div>
	</Base>
</html>
