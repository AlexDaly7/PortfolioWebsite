---
import { getCollection } from "astro:content";

let posts = (await getCollection("blog")).sort(
    (a, b) => b.data.updateDate.valueOf() - a.data.updateDate.valueOf()
);
if(posts.length>=6) {
    posts = posts.splice(1, 5);
}

---

<div class="p-2 max-h-80 lightBg " id="body">
    <h2 class="w-30 text-center text-xl border-b-2 mb-1.5">Recent Blogs</h2>
    <ul class="max-h-65 overflow-y-auto">
        {posts.map(post => (
            <li class="mb-4">
                <a href={`/blog/${post.id}/`}
                class="">
                    <h2 class="inline text-xl">{post.data.title}</h2> <h3 class="inline text-xs">{post.data.updateDate.toLocaleDateString()}</h3>
                    
                    <p>{post.data.desc}</p>
                </a>
            </li>
        ))}
    </ul>
</div>