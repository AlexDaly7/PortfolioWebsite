---
import { getCollection } from "astro:content";

let posts = (await getCollection("blog")).sort(
    (a, b) => b.data.updateDate.valueOf() - a.data.updateDate.valueOf()
);
if(posts.length>=6) {
    posts = posts.splice(1, 5);
}

---

<style>
    #body {
        box-shadow: #d2b5ff 2px 2px 3px;
    }
</style>

<div class="w-70 p-2 bg-mauve-200 h-40" id="body">
    <h2 class="text-center text-xl border-b-2 mb-1.5">Recent Blogs</h2>
    <ul class="overflow-auto">
        {posts.map(post => (
            <li>
                <a href={`/blog/${post.id}/`}
                class="ml-2 transition-all hover:text-shadow-xs hover:text-shadow-mauve-400">
                    {post.data.title}
                </a>
            </li>
        ))}
        {(posts.length<=5) &&
            <p class="ml-2">...</p>
        }
    </ul>
</div>