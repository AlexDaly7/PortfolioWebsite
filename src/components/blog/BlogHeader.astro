---
const links = [
    {link: "/", name: "Home"},
    {link: "/blog", name: "Blog Menu"}
]
---

<div class="flex w-auto h-10 text-left text-2xl text-mist-600">
    {links.map((link) => (
        <a href={link.link}
        class="linkHover mr-5">
            {link.name}
        </a>
    ))}
</div>

