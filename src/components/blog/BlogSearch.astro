---
    import { getCollection } from "astro:content";

    let posts = await getCollection("blog");

    let tagList = (await getCollection("blog")).map((post) => post.data.tags);
    let tags: string[] = new Array();


    // TODO: Use hashset to make this like 100x more efficient
    // Search all posts for all tags
    tagList.forEach((postTags) => {
        postTags.forEach((tag) => {
            let tagExists = false;

            // If tags array is empty then push tag to tags as it cannot be a duplicate
            if(tags.length==0) {
                tags.push(tag);
            }

            // Check if it is present in the tags array (already parsed).
            tags.forEach((parsedTag) => {
                if(tag==parsedTag) {
                    tagExists = true;
                }
            });
            // Push to tags array if tag has not already been parsed
            if(!tagExists) {
                tags.push(tag);
            }
        })
    });
---

<div id="search" class="p-4 min-h-70 max-h-80 lightBg">
    <div id="filters">
        <h3 class="text-lg border-b-2 w-11 text-center mb-2">Tags</h3>
        <div id="tags" class="">
            
        </div>
    </div>
    <button id="searchButton" class="button p-1 text-lg rounded-md mt-4">Search</button>
    <h2 class="border-b-2 w-17 text-xl mt-3 mb-1 text-center">Results</h2>
    <div id="results" class="overflow-y-auto">

    </div>
</div>

<style>

    :global(.tagBtn) {
        padding: 5px;
        text-align: center;
        font-size: 0.9rem;
        background-color: #e7e7e785;
        transition: 0.2s transform;
        border-radius: 10%;
        transition: 0.5s all;
        margin-right: 2px;
        margin-bottom: 2px;
    }

    :global(.tagBtn:hover) {
        transform: scale(1.05);
        background-color: #e7e7e7;
        box-shadow: #ccc7d6 2px 2px 3px;
    }

    :global(.addTag) {
        
    }

    :global(.removeTag) {
        background-color:#d1c7df;
    }

    :global(.searchResult) {
        display:block;
    }
    
</style>

<script define:vars={{tags, posts}} lang="ts">

    const tagListElement = document.getElementById("tags");

    // Add tag buttons
    tags.forEach((tag) => {
        let element = document.createElement("button");
        element.classList.add("tagBtn");
        element.classList.add("addTag");
        element.onclick = function() {changeTag(element, tag)}
        element.append(document.createTextNode(tag));
        tagListElement.append(element);
    });
    
    // Search button listener
    const searchBtn = document.getElementById("searchButton");
    searchBtn.addEventListener("click", () => search());
    
    // Change button to other button on click
    function changeTag(element, tag) {
        if(element.classList.contains("addTag")) {
            addTag(tag);
            element.classList.remove("addTag");
            element.classList.add("removeTag");
        } else {
            removeTag(tag);
            element.classList.remove("removeTag");
            element.classList.add("addTag");
        }
    }

    var searchTags = new Array();
    var searchResults = new Array();

    function addTag(tag) {
        if(!searchTags.includes(tag)) searchTags.push(tag);
    }

    function removeTag(tag) {
        if(searchTags.includes(tag)) {
            searchTags = searchTags.filter(tags => tags != tag);
        }
    }

    function search() {
        searchResults = [];
        searchResults = posts.filter((post) => {
            return searchTags.every((searchTag) => post.data.tags.includes(searchTag));
        });
        displayResults();
    }

    function displayResults() {
        const list = document.getElementById("results");

        while(list?.hasChildNodes()) list.removeChild(list.firstChild);

        if(searchResults.length!=0) {
            searchResults.forEach((result) => {
                console.log("Adding result");
                let element = document.createElement("a");
                element.href = "/blog/"+result.data.slug;
                element.classList.add("searchResult");
                element.appendChild(document.createTextNode(result.data.title));
                list?.append(element);
            });
        } else {
            let element = document.createElement("p");
            element.appendChild(document.createTextNode("No blogs found..."));
            list?.append(element);
        }
        
    }
    
</script>
